# ================================================
# السوري معك — Environment Variables Example
# ================================================
# انسخ هذا الملف إلى .env وعدّل القيم

# App Environment
APP_ENV=development

# Expo
EXPO_PUBLIC_DOMAIN=your-replit-domain.replit.dev
EXPO_PUBLIC_REPL_ID=your-repl-id

# API Server (if used)
API_BASE_URL=https://your-domain.com/api

# Storage (AsyncStorage is used locally by default)
# For cloud sync, add your backend URL:
# STORAGE_SYNC_URL=https://your-backend.com/sync
